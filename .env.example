# Copier ce fichier vers .env.local et remplir avec les valeurs de votre projet Supabase
# (Dashboard Supabase > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé "service_role" (secrète) — nécessaire pour la gestion des utilisateurs
# (création de comptes). Dashboard Supabase > Settings > API > service_role.
# NE JAMAIS exposer côté client ni committer publiquement.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Google Drive (supports de cours PDF) — OAuth avec ton compte Google
# 1. Client OAuth "Application Web" dans Google Cloud Console
#    URI de redirection : http://localhost:3001/api/google/callback
# 2. Visite /api/google/auth (connecté en admin) pour obtenir le refresh token
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
GOOGLE_REFRESH_TOKEN=1//...
GOOGLE_DRIVE_FOLDER_ID=1AbC...

# Devise affichée dans l'interface (ex: DA, €, MAD). Défaut : DA
NEXT_PUBLIC_CURRENCY=DA

# ---------------------------------------------------------------------
# Domaine racine — chaque école vit sur <slug>.<ce domaine>
# ATTENTION : cette variable est figée au moment du build. La définir sur
# Vercel ne suffit pas, il faut redéployer après l'avoir ajoutée.
# En local, laisser vide (l'app retombe sur "localhost").
NEXT_PUBLIC_ROOT_DOMAIN=maxschool.duckdns.org

# ---------------------------------------------------------------------
# Déclaration automatique du sous-domaine à chaque inscription d'école.
# Sans ces trois valeurs, l'inscription fonctionne quand même : il faudra
# simplement ajouter le sous-domaine à la main dans Vercel.
#
# VERCEL_API_TOKEN  : vercel.com/account/tokens (portée : votre projet)
# VERCEL_PROJECT_ID : Settings > General > Project ID (commence par prj_)
# VERCEL_TEAM_ID    : seulement si le projet appartient à une équipe
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
